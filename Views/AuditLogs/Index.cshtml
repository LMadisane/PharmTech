@model IEnumerable<PharmTech.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div x-data="auditLogsApp()" x-init="init()" class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">🔍Audit Logs</h1>
            <p class="text-gray-700 dark:text-gray-300 text-sm">Complete audit trail of all system actions</p>
        </div>
        <div class="flex gap-3">
            <button @@click="refreshLogs()"
                class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-xl transition duration-200 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
            <button @@click="exportLogs()"
                class="border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold px-4 py-2 rounded-xl transition duration-200 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export CSV
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 md:p-6 mb-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">User</label>
                <input type="text"
                       x-model="filters.user"
                       placeholder="Search by user name..."
                       class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 dark:bg-gray-700 dark:text-white">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Action</label>
                <input type="text"
                       x-model="filters.action"
                       placeholder="Search action..."
                       class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 dark:bg-gray-700 dark:text-white">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Entity</label>
                <input type="text"
                       x-model="filters.entity"
                       placeholder="Search entity..."
                       class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 dark:bg-gray-700 dark:text-white">
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">From</label>
                    <input type="date"
                           x-model="filters.from"
                           class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 dark:bg-gray-700 dark:text-white">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">To</label>
                    <input type="date"
                           x-model="filters.to"
                           class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 dark:bg-gray-700 dark:text-white">
                </div>
            </div>
        </div>
        <div class="flex flex-wrap gap-3 mt-4">
            <button @@click="applyFilters()"
                class="bg-teal-600 hover:bg-teal-700 text-white font-medium px-5 py-2 rounded-lg transition duration-200 text-sm inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Apply Filters
            </button>
            <button @@click="resetFilters()"
                class="border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium px-5 py-2 rounded-lg transition duration-200 text-sm">
                Reset
            </button>
            <span class="text-sm text-gray-500 dark:text-gray-400 ml-auto self-center">
                Showing <span x-text="logs.length"></span> entries
            </span>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-700 border-b border-gray-100 dark:border-gray-600">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Timestamp</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">User</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Role</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Action</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Entity</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Details</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">IP Address</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    <template x-for="log in logs" :key="log.auditLogId">
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap" x-text="formatDateTime(log.timestamp)"></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="log.userName"></td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 text-xs font-semibold rounded-full" :class="roleBadge(log.userRole)">
                                    <span x-text="log.userRole"></span>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 text-xs font-semibold rounded-full" :class="actionBadge(log.action)">
                                    <span x-text="log.action"></span>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="log.entity"></td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                <span x-text="log.details || '—'"></span>
                                <template x-if="log.previousValue && log.newValue">
                                    <span class="block text-xs text-gray-400 dark:text-gray-500">
                                        Changed: <span x-text="log.previousValue"></span> → <span x-text="log.newValue"></span>
                                    </span>
                                </template>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 font-mono text-xs" x-text="log.ipAddress || '—'"></td>
                        </tr>
                    </template>
                    <tr x-show="loading && logs.length === 0">
                        <td colspan="7" class="px-6 py-12 text-center">
                            <div class="flex justify-center">
                                <svg class="animate-spin h-8 w-8 text-teal-500" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                            </div>
                            <p class="mt-2 text-gray-400 text-sm">Loading audit logs...</p>
                        </td>
                    </tr>
                    <tr x-show="!loading && logs.length === 0">
                        <td colspan="7" class="px-6 py-12 text-center">
                            <div class="text-gray-400 dark:text-gray-500">
                                <span class="text-4xl">📭</span>
                                <p class="mt-2">No audit logs found</p>
                                <p class="text-xs mt-1">Try adjusting your filters</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function auditLogsApp() {
            return {
                logs: [],
                loading: false,
                filters: {
                    user: '',
                    action: '',
                    entity: '',
                    from: '',
                    to: ''
                },

                init() {
                    this.loadLogs();
                },

                async loadLogs() {
                    this.loading = true;
                    try {
                        let url = '/api/auditlogs?limit=500';
                        if (this.filters.user) url += `&user=${encodeURIComponent(this.filters.user)}`;
                        if (this.filters.action) url += `&action=${encodeURIComponent(this.filters.action)}`;
                        if (this.filters.entity) url += `&entity=${encodeURIComponent(this.filters.entity)}`;
                        if (this.filters.from) url += `&from=${this.filters.from}`;
                        if (this.filters.to) url += `&to=${this.filters.to}`;

                        const response = await fetch(url);
                        const result = await response.json();
                        if (result.success) {
                            this.logs = result.logs || [];
                        }
                    } catch (err) {
                        console.error('Error loading audit logs:', err);
                    } finally {
                        this.loading = false;
                    }
                },

                applyFilters() {
                    this.loadLogs();
                },

                resetFilters() {
                    this.filters = { user: '', action: '', entity: '', from: '', to: '' };
                    this.loadLogs();
                },

                refreshLogs() {
                    this.loadLogs();
                },

                exportLogs() {
                    if (this.logs.length === 0) {
                        showToast('No logs to export', 'warning');
                        return;
                    }

                    // Simple CSV export
                    let csv = 'Timestamp,User,Role,Action,Entity,Details,IP Address\n';
                    this.logs.forEach(log => {
                        csv += `${log.timestamp},${log.userName},${log.userRole},${log.action},${log.entity},"${log.details || ''}",${log.ipAddress || ''}\n`;
                    });

                    const blob = new Blob([csv], { type: 'text/csv' });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `audit-logs-${new Date().toISOString().split('T')[0]}.csv`;
                    a.click();
                    window.URL.revokeObjectURL(url);
                    showToast('Export started', 'success');
                },

                roleBadge(role) {
                    const badges = {
                        'Admin': 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
                        'Doctor': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
                        'Pharmacist': 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200',
                        'Patient': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
                        'System': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'
                    };
                    return badges[role] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
                },

                actionBadge(action) {
                    const badges = {
                        'Login': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
                        'Logout': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
                        'Create': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
                        'Update': 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
                        'Delete': 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
                        'Approve': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
                        'Reject': 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
                        'Fulfill': 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
                        'Dispense': 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200',
                        'Restock': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
                        'Dispose': 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
                        'Mark Read': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
                        'System': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'
                    };
                    return badges[action] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
                },

                formatDateTime(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    });
                }
            }
        }
    </script>
}