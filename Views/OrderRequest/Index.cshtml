@model IEnumerable<PharmTech.Models.OrderRequest>
@{
    ViewData["Title"] = "Order Requests";
    var isAdmin = User.IsInRole("Admin");
}

<div x-data="orderApp()" x-init="init(@isAdmin.ToString().ToLower())" class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">🛒Order Requests</h1>
            <p class="text-gray-700 dark:text-gray-300 text-sm">Track and manage orders</p>
        </div>
        @if (!isAdmin)
        {
            <a asp-controller="OrderRequest" asp-action="CreateRequest"
               class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-5 py-2.5 rounded-xl transition duration-200 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Order Request
            </a>
        }
    </div>

    <!-- Tabs (Admin only) -->
    @if (isAdmin)
    {
        <div class="border-b border-gray-200 dark:border-gray-700 mb-6">
            <ul class="flex flex-wrap -mb-px text-sm font-medium text-center">
                <li class="mr-2">
                    <button @@click="activeTab = 'all'"
                        class="inline-block p-4 border-b-2 rounded-t-lg transition"
                        :class="activeTab === 'all' ? 'border-teal-600 text-teal-600 dark:border-teal-400 dark:text-teal-400' : 'border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-400'">
                        📋All Orders
                    </button>
                </li>
                <li class="mr-2">
                    <button @@click="activeTab = 'pending'"
                        class="inline-block p-4 border-b-2 rounded-t-lg transition"
                        :class="activeTab === 'pending' ? 'border-teal-600 text-teal-600 dark:border-teal-400 dark:text-teal-400' : 'border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-400'">
                        ⏳Pending (<span x-text="pendingCount"></span>)
                    </button>
                </li>
                <li class="mr-2">
                    <button @@click="activeTab = 'approved'"
                        class="inline-block p-4 border-b-2 rounded-t-lg transition"
                        :class="activeTab === 'approved' ? 'border-teal-600 text-teal-600 dark:border-teal-400 dark:text-teal-400' : 'border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-400'">
                        ✅Approved
                    </button>
                </li>
                <li class="mr-2">
                    <button @@click="activeTab = 'rejected'"
                        class="inline-block p-4 border-b-2 rounded-t-lg transition"
                        :class="activeTab === 'rejected' ? 'border-teal-600 text-teal-600 dark:border-teal-400 dark:text-teal-400' : 'border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-400'">
                        ❌Rejected
                    </button>
                </li>
                <li class="mr-2">
                    <button @@click="activeTab = 'fulfilled'"
                        class="inline-block p-4 border-b-2 rounded-t-lg transition"
                        :class="activeTab === 'fulfilled' ? 'border-teal-600 text-teal-600 dark:border-teal-400 dark:text-teal-400' : 'border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-400'">
                        📦Fulfilled
                    </button>
                </li>
            </ul>
        </div>
    }

    <!-- Orders Table -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-700 border-b border-gray-100 dark:border-gray-600">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Medicine</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Quantity</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Supplier</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Requested</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Fulfilled</th>
                        @if (isAdmin)
                        {
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <template x-for="order in filteredOrders" :key="order.orderId">
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                            <td class="px-6 py-4 text-sm font-medium text-gray-800 dark:text-gray-200" x-text="order.medicineName || 'Unknown'"></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="order.quantity"></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="order.supplierName || 'N/A'"></td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 text-xs font-semibold rounded-full" :class="statusBadge(order.status)">
                                    <span x-text="order.status"></span>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400" x-text="formatDate(order.requestedAt)"></td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400" x-text="order.fulfilledAt ? formatDate(order.fulfilledAt) : '—'"></td>
                            @if (isAdmin)
                            {
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <!-- Approve/Reject -->
                                    <template x-if="order.status === 'Pending'">
                                        <div>
                                            <button @@click="approveOrder(order.orderId)" class="bg-green-600 hover:bg-green-700 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition mr-2">Approve</button>
                                            <button @@click="rejectOrder(order.orderId)" class="bg-red-600 hover:bg-red-700 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition">Reject</button>
                                        </div>
                                    </template>
                                    <!-- Fulfill -->
                                    <template x-if="order.status === 'Approved'">
                                        <button @@click="fulfillOrder(order.orderId)" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition">Fulfill</button>
                                    </template>
                                    <span x-if="order.status !== 'Pending' && order.status !== 'Approved'" class="text-gray-400 text-xs">—</span>
                                </td>
                            }
                        </tr>
                    </template>
                </tbody>
            </table>
            <div x-show="loading && filteredOrders.length === 0" class="text-center py-12">
                <div class="flex justify-center">
                    <svg class="animate-spin h-8 w-8 text-teal-500" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                </div>
                <p class="mt-2 text-gray-400 text-sm">Loading orders...</p>
            </div>
            <div x-show="!loading && filteredOrders.length === 0" class="text-center py-12 text-gray-400 dark:text-gray-500">
                <span class="text-4xl">📭</span>
                <p class="mt-2">No orders found for this filter</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function orderApp() {
            return {
                orders: [],
                filteredOrders: [],
                loading: false,
                activeTab: 'all',
                isAdmin: false,

                init(isAdmin) {
                    this.isAdmin = isAdmin;
                    this.loadOrders();
                },

                async loadOrders() {
                    this.loading = true;
                    try {
                        const response = await fetch('/api/orderrequest');
                        const result = await response.json();
                        if (result.success) {
                            this.orders = result.orders || [];
                            this.applyFilter();
                        }
                    } catch (err) {
                        console.error('Error loading orders:', err);
                    } finally {
                        this.loading = false;
                    }
                },

                applyFilter() {
                    if (this.activeTab === 'all') {
                        this.filteredOrders = this.orders;
                    } else {
                        this.filteredOrders = this.orders.filter(o => o.status.toLowerCase() === this.activeTab);
                    }
                },

                get pendingCount() {
                    return this.orders.filter(o => o.status === 'Pending').length;
                },

                async approveOrder(id) {
                    if (!confirm('Approve this order?')) return;
                    try {
                        const response = await fetch(`/api/orderrequest/${id}/approve`, { method: 'PUT' });
                        const result = await response.json();
                        if (result.success) {
                            showToast('Order approved', 'success');
                            this.loadOrders();
                        } else {
                            showToast(result.message || 'Failed to approve order', 'error');
                        }
                    } catch (err) {
                        console.error('Error approving order:', err);
                        showToast('An error occurred', 'error');
                    }
                },

                async rejectOrder(id) {
                    if (!confirm('Reject this order?')) return;
                    try {
                        const response = await fetch(`/api/orderrequest/${id}/reject`, { method: 'PUT' });
                        const result = await response.json();
                        if (result.success) {
                            showToast('Order rejected', 'success');
                            this.loadOrders();
                        } else {
                            showToast(result.message || 'Failed to reject order', 'error');
                        }
                    } catch (err) {
                        console.error('Error rejecting order:', err);
                        showToast('An error occurred', 'error');
                    }
                },

                async fulfillOrder(id) {
                    if (!confirm('Fulfill this order? This will add stock to inventory.')) return;
                    try {
                        const response = await fetch(`/api/orderrequest/${id}/fulfill`, { method: 'PUT' });
                        const result = await response.json();
                        if (result.success) {
                            showToast('Order fulfilled, stock added', 'success');
                            this.loadOrders();
                        } else {
                            showToast(result.message || 'Failed to fulfill order', 'error');
                        }
                    } catch (err) {
                        console.error('Error fulfilling order:', err);
                        showToast('An error occurred', 'error');
                    }
                },

                statusBadge(status) {
                    const badges = {
                        'Pending': 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
                        'Approved': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
                        'Rejected': 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
                        'Fulfilled': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
                    };
                    return badges[status] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                }
            }
        }
    </script>
}