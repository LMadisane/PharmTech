@{
    ViewData["Title"] = "Dispensing";
}

<div x-data="dispensingApp()" x-init="init()" class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">💊 Dispensing</h1>
        <p class="text-gray-500 text-sm">Search and dispense prescriptions by reference code</p>
    </div>

    <!-- Search Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
        <div class="flex gap-3">
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-1">Prescription Reference Code</label>
                <input type="text"
                       x-model="referenceCode"
                @@keyup.enter="searchPrescription()"
                       placeholder="e.g., RX-638729472938"
                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent">
            </div>
            <div class="flex items-end">
                <button @@click="searchPrescription()"
                    :disabled="loading"
                    class="bg-teal-600 hover:bg-teal-700 disabled:bg-teal-400 text-white font-semibold px-6 py-2.5 rounded-xl transition duration-200">
                    <span x-show="!loading">Search</span>
                    <span x-show="loading" class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Searching...
                    </span>
                </button>
            </div>
        </div>

        <!-- Error Message -->
        <div x-show="error" x-text="error" class="mt-3 text-sm text-red-600 bg-red-50 rounded-xl px-4 py-2"></div>
    </div>

    <!-- Prescription Details -->
    <div x-show="prescription" x-transition.duration.300ms class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-teal-600 to-teal-700 px-6 py-4">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-white font-bold text-lg">Prescription Details</h2>
                    <p class="text-teal-100 text-sm" x-text="prescription?.referenceCode"></p>
                </div>
                <div>
                    <span :class="statusBadge(prescription?.status)" class="px-3 py-1 rounded-full text-xs font-semibold">
                        <span x-text="prescription?.status"></span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Patient Info -->
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Patient Information</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-gray-400">Patient Name</p>
                    <p class="text-gray-800 font-medium" x-text="prescription?.patient?.name"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400">Patient Email</p>
                    <p class="text-gray-800" x-text="prescription?.patient?.email"></p>
                </div>
            </div>
        </div>

        <!-- Medicine Info -->
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Medicine Information</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-gray-400">Medicine</p>
                    <p class="text-gray-800 font-medium" x-text="prescription?.medicine?.name"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400">Dosage Form</p>
                    <p class="text-gray-800" x-text="prescription?.medicine?.dosageForm || 'N/A'"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400">Dosage</p>
                    <p class="text-gray-800" x-text="prescription?.dosagePerDay + ' per day'"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400">Duration</p>
                    <p class="text-gray-800" x-text="prescription?.durationDays + ' days'"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400">Total Quantity Required</p>
                    <p class="text-gray-800 font-semibold text-lg" x-text="prescription?.totalQuantity"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400">Prescribed Date</p>
                    <p class="text-gray-800" x-text="formatDate(prescription?.prescribedAt)"></p>
                </div>
            </div>
        </div>

        <!-- Dispense Action -->
        <div class="p-6 bg-gray-50">
            <div x-show="prescription?.status === 'Pending'">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Select Facility</label>
                    <select x-model="facilityId"
                            x-show="facilities.length > 0"
                            class="w-full max-w-md px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                        <option value="">Select facility...</option>
                        <template x-for="facility in facilities" :key="facility.facilityId">
                            <option :value="facility.facilityId" x-text="facility.name"></option>
                        </template>
                    </select>
                    <div x-show="facilities.length === 0 && !loadingFacilities" class="text-sm text-yellow-600 bg-yellow-50 rounded-xl px-4 py-2">
                        ⚠️ No facilities available. Please contact administrator.
                    </div>
                    <div x-show="loadingFacilities" class="text-sm text-gray-500">
                        Loading facilities...
                    </div>
                </div>
                <button @@click="dispensePrescription()"
                    :disabled="dispensing || !facilityId"
                    class="bg-green-600 hover:bg-green-700 disabled:bg-green-400 text-white font-semibold px-8 py-3 rounded-xl transition duration-200 flex items-center gap-2">
                    <span x-show="!dispensing">✅ Dispense Medication</span>
                    <span x-show="dispensing" class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Processing...
                    </span>
                </button>
                <p x-show="!facilityId && prescription?.status === 'Pending' && facilities.length > 0" class="mt-2 text-xs text-yellow-600">
                    Please select a facility to dispense from
                </p>
            </div>
            <div x-show="prescription?.status === 'Dispensed'" class="text-center py-4">
                <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-4 py-2 rounded-full">
                    <span>✅</span>
                    <span class="text-sm font-medium">This prescription has already been dispensed</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Dispense Success Modal -->
    <div x-show="showSuccess"
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
        @@click.away="showSuccess = false">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full mx-4 p-6" @@click.stop>
            <div class="text-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">✅</span>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Dispensed Successfully!</h3>
                <p class="text-gray-500 text-sm mb-4">The medication has been dispensed successfully.</p>
                <div class="bg-gray-50 rounded-xl p-4 mb-4 text-left">
                    <p class="text-sm text-gray-600"><strong>Remaining Stock:</strong> <span x-text="dispenseResult?.remainingStock"></span></p>
                    <p class="text-sm text-gray-600"><strong>Receipt Number:</strong> <span x-text="dispenseResult?.receipt?.receiptNumber"></span></p>
                </div>
                <div class="flex gap-3">
                    <button @@click="resetForm()" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-xl transition">
                        Dispense Another
                    </button>
                    <button @@click="window.location.href = '/receipts'" class="flex-1 border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-4 py-2 rounded-xl transition">
                        View Receipt
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function dispensingApp() {
            return {
                referenceCode: '',
                prescription: null,
                facilityId: '',
                facilities: [],
                loading: false,
                loadingFacilities: false,
                dispensing: false,
                error: null,
                showSuccess: false,
                dispenseResult: null,

                init() {
                    // Load facilities when page loads
                    this.loadFacilities();
                    
                    // Check if there's a reference code in the URL
                    const urlParams = new URLSearchParams(window.location.search);
                    const code = urlParams.get('ref');
                    if (code) {
                        this.referenceCode = code;
                        this.searchPrescription();
                    }
                },

                async loadFacilities() {
                    this.loadingFacilities = true;
                    try {
                        const response = await fetch('/api/dispensing/facilities');
                        const result = await response.json();
                        
                        if (result.success) {
                            this.facilities = result.data;
                        } else {
                            console.error('Failed to load facilities:', result.message);
                            showToast('Failed to load facilities', 'error');
                        }
                    } catch (err) {
                        console.error('Error loading facilities:', err);
                        showToast('Error loading facilities', 'error');
                    } finally {
                        this.loadingFacilities = false;
                    }
                },

                async searchPrescription() {
                    if (!this.referenceCode.trim()) {
                        this.error = 'Please enter a prescription reference code';
                        return;
                    }

                    this.loading = true;
                    this.error = null;

                    try {
                        const response = await fetch(`/api/dispensing/${encodeURIComponent(this.referenceCode)}`);
                        const result = await response.json();

                        if (result.success) {
                            this.prescription = result.prescription;
                            // Reset facility selection when new prescription loads
                            this.facilityId = '';
                        } else {
                            this.error = result.message || 'Prescription not found';
                            this.prescription = null;
                        }
                    } catch (err) {
                        this.error = 'An error occurred while searching';
                        console.error(err);
                        showToast('An error occurred while searching', 'error');
                    } finally {
                        this.loading = false;
                    }
                },

                async dispensePrescription() {
                    if (!this.facilityId) {
                        this.error = 'Please select a facility';
                        return;
                    }

                    this.dispensing = true;
                    this.error = null;

                    try {
                        // Get the current user ID from the session or claim
                        const userId = @Html.Raw(Json.Serialize(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"));
                        
                        const request = {
                            prescriptionId: this.prescription.prescriptionId,
                            facilityId: parseInt(this.facilityId),
                            dispensedById: parseInt(userId)
                        };

                        const response = await fetch('/api/dispensing/dispense', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(request)
                        });

                        const result = await response.json();

                        if (result.success) {
                            this.dispenseResult = result.data;
                            this.showSuccess = true;
                            showToast('Prescription dispensed successfully!', 'success');
                        } else {
                            this.error = result.message || 'Dispensing failed';
                            showToast(this.error, 'error');
                        }
                    } catch (err) {
                        this.error = 'An error occurred while dispensing';
                        console.error(err);
                        showToast('An error occurred while dispensing', 'error');
                    } finally {
                        this.dispensing = false;
                    }
                },

                resetForm() {
                    this.showSuccess = false;
                    this.prescription = null;
                    this.referenceCode = '';
                    this.facilityId = '';
                    this.dispenseResult = null;
                    this.error = null;
                },

                statusBadge(status) {
                    const colors = {
                        'Pending': 'bg-yellow-100 text-yellow-800',
                        'Dispensed': 'bg-green-100 text-green-800',
                        'Expired': 'bg-red-100 text-red-800'
                    };
                    return colors[status] || 'bg-gray-100 text-gray-800';
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                }
            }
        }
    </script>
}