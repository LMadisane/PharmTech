@using System.Security.Claims
@{
    ViewData["Title"] = "Dispensing";
}

<div x-data="dispensingApp()" x-init="init()" class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">💊 Dispensing</h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Search and dispense prescriptions by reference code</p>
    </div>

    <!-- Search Section -->
    <div class="glass p-6 mb-6 transition-all duration-300">
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">
                    Prescription Reference Code
                </label>
                <div class="glass-search w-full">
                    <svg class="search-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text"
                           x-model="referenceCode"
                    @@keyup.enter="searchPrescription()"
                           placeholder="e.g., RX-20250505-ABC123"
                           class="w-full px-4 py-2 bg-transparent border-0 focus:ring-0 text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 text-sm">
                </div>
            </div>
            <div class="flex items-end gap-2">
                <button @@click="searchPrescription()"
                    x-bind:disabled="loading"
                    class="bg-teal-600 hover:bg-teal-700 disabled:bg-teal-400 text-white font-semibold px-6 py-2.5 rounded-xl transition duration-200 inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span x-show="!loading">Search</span>
                    <span x-show="loading" class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                        Searching...
                    </span>
                </button>
            </div>
        </div>
        <div x-show="error" x-text="error" class="mt-3 text-sm text-red-600 dark:text-red-400 bg-red-50/50 dark:bg-red-900/20 backdrop-blur-sm rounded-xl px-4 py-2 border border-red-200/50 dark:border-red-800/30"></div>
    </div>

    <!-- Pending Prescriptions Table -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white">📋 Pending Prescriptions</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">Prescriptions ready for dispensing at your facility</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-700 border-b border-gray-100 dark:border-gray-600">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Reference</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Patient</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Medicine</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Dosage</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Qty</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Prescribed Date</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    <template x-for="prescription in pendingPrescriptions" :key="prescription.prescriptionId">
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                            <td class="px-6 py-4">
                                <span class="font-mono text-sm font-medium text-gray-800 dark:text-gray-200" x-text="prescription.referenceCode"></span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="prescription.patient.name"></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="prescription.medicine.name"></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300" x-text="prescription.dosagePerDay + '/day'"></td>
                            <td class="px-6 py-4 text-sm font-medium text-gray-800 dark:text-gray-200" x-text="prescription.totalQuantity"></td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400" x-text="formatDate(prescription.prescribedAt)"></td>
                            <td class="px-6 py-4">
                                <button @@click="quickDispense(prescription.referenceCode)"
                                    class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-3 py-1.5 rounded-lg transition inline-flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                    </svg>
                                    Dispense
                                </button>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="loadingPrescriptions && pendingPrescriptions.length === 0">
                        <td colspan="7" class="px-6 py-12 text-center">
                            <div class="flex justify-center">
                                <svg class="animate-spin h-8 w-8 text-teal-500" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                            </div>
                            <p class="mt-2 text-gray-400 text-sm">Loading prescriptions...</p>
                        </td>
                    </tr>
                    <tr x-show="!loadingPrescriptions && pendingPrescriptions.length === 0">
                        <td colspan="7" class="px-6 py-12 text-center text-gray-400 dark:text-gray-500">
                            <span class="text-4xl">📭</span>
                            <p class="mt-2">No pending prescriptions found</p>
                            <p class="text-xs mt-1">All prescriptions at your facility have been dispensed</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Prescription Details Modal for search results -->
    <div x-show="showModal"
         x-cloak
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @@click.away="closeModal()">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto" @@click.stop>
            <div class="sticky top-0 bg-white dark:bg-gray-800 border-b border-gray-100 dark:border-gray-700 px-6 py-4 flex justify-between items-center">
                <h3 class="text-lg font-bold text-gray-800 dark:text-white">Prescription Details</h3>
                <button @@click="closeModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="p-6" x-show="selectedPrescription">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-50 dark:bg-teal-900/50 rounded-2xl mb-3">
                        <span class="text-3xl">📋</span>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Prescription</h2>
                    <p class="text-xs text-gray-400 dark:text-gray-500 font-mono" x-text="selectedPrescription?.referenceCode"></p>
                    <div class="mt-3 h-px bg-gray-200 dark:bg-gray-700"></div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div>
                        <p class="text-xs text-gray-400 dark:text-gray-500">Status</p>
                        <span class="inline-block px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200 mt-1">
                            <span x-text="selectedPrescription?.status"></span>
                        </span>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 dark:text-gray-500">Prescribed Date</p>
                        <p class="text-sm text-gray-700 dark:text-gray-300" x-text="formatDateTime(selectedPrescription?.prescribedAt)"></p>
                    </div>
                </div>

                <div class="h-px bg-gray-200 dark:bg-gray-700 my-4"></div>

                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Patient Information</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Patient Name</p>
                            <p class="text-sm font-medium text-gray-800 dark:text-white" x-text="selectedPrescription?.patient?.name"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Patient Email</p>
                            <p class="text-sm text-gray-700 dark:text-gray-300" x-text="selectedPrescription?.patient?.email"></p>
                        </div>
                    </div>
                </div>

                <div class="h-px bg-gray-200 dark:bg-gray-700 my-4"></div>

                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Prescription Details</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Medicine</p>
                            <p class="text-sm font-medium text-gray-800 dark:text-white" x-text="selectedPrescription?.medicine?.name"></p>
                            <p class="text-xs text-gray-400 dark:text-gray-500" x-text="selectedPrescription?.medicine?.dosageForm"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Dosage</p>
                            <p class="text-sm text-gray-800 dark:text-white" x-text="selectedPrescription?.dosagePerDay + ' time(s) per day'"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Duration</p>
                            <p class="text-sm text-gray-800 dark:text-white" x-text="selectedPrescription?.durationDays + ' days'"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Total Quantity</p>
                            <p class="text-sm font-semibold text-gray-800 dark:text-white" x-text="selectedPrescription?.totalQuantity + ' units'"></p>
                        </div>
                    </div>
                </div>

                <div class="flex gap-3 mt-6 pt-4 border-t border-gray-100 dark:border-gray-700">
                    <button @@click="dispenseFromModal()"
                        x-show="selectedPrescription?.status === 'Pending'"
                        class="flex-1 bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg transition text-sm inline-flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        Dispense Medication
                    </button>
                    <button @@click="closeModal()"
                        class="flex-1 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold px-4 py-2 rounded-lg transition text-sm">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Dispense Success Modal -->
    <div x-show="showSuccess"
         x-cloak
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
        @@click.away="showSuccess = false">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl max-w-md w-full mx-4 p-6" @@click.stop>
            <div class="text-center">
                <div class="w-16 h-16 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">✅</span>
                </div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Dispensed Successfully!</h3>
                <p class="text-gray-500 dark:text-gray-400 text-sm mb-4">The medication has been dispensed successfully.</p>
                <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 mb-4 text-left">
                    <p class="text-sm text-gray-600 dark:text-gray-300"><strong>Receipt Number:</strong> <span x-text="dispenseResult?.receipt?.receiptNumber"></span></p>
                </div>
                <div class="flex gap-3">
                    <button @@click="resetAndRefresh()" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-xl transition">
                        Continue
                    </button>
                    <a href="/Receipt/Index" class="flex-1 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold px-4 py-2 rounded-xl transition text-center">
                        View Receipt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function dispensingApp() {
            return {
                referenceCode: '',
                pendingPrescriptions: [],
                selectedPrescription: null,
                facilityName: '',
                loading: false,
                loadingPrescriptions: false,
                dispensing: false,
                error: null,
                showModal: false,
                showSuccess: false,
                dispenseResult: null,

                init() {
                    this.loadPharmacistFacility();
                    this.loadPendingPrescriptions();
                },

                async loadPharmacistFacility() {
                    try {
                        const response = await fetch('/api/users/current');
                        const result = await response.json();
                        if (result.success && result.facility) {
                            this.facilityName = result.facility.name;
                        }
                    } catch (err) {
                        console.error('Error loading facility:', err);
                    }
                },

                async loadPendingPrescriptions() {
                    this.loadingPrescriptions = true;
                    try {
                        const response = await fetch('/api/prescription?status=Pending');
                        const result = await response.json();
                        if (result.success) {
                            this.pendingPrescriptions = result.prescriptions || [];
                        }
                    } catch (err) {
                        console.error('Error loading prescriptions:', err);
                        this.pendingPrescriptions = [];
                    } finally {
                        this.loadingPrescriptions = false;
                    }
                },

                async searchPrescription() {
                    if (!this.referenceCode.trim()) {
                        this.error = 'Please enter a prescription reference code';
                        return;
                    }

                    this.loading = true;
                    this.error = null;

                    try {
                        const response = await fetch(`/api/dispensing/${encodeURIComponent(this.referenceCode)}`);
                        const result = await response.json();

                        if (result.success) {
                            this.selectedPrescription = result.prescription;
                            this.showModal = true;
                            this.referenceCode = '';
                        } else {
                            this.error = result.message || 'Prescription not found';
                        }
                    } catch (err) {
                        this.error = 'An error occurred while searching';
                        console.error(err);
                    } finally {
                        this.loading = false;
                    }
                },

                async quickDispense(referenceCode) {
                    this.referenceCode = referenceCode;
                    await this.searchPrescription();
                },

                async dispenseFromModal() {
                    if (!this.selectedPrescription) return;

                    this.dispensing = true;
                    this.error = null;

                    try {
                        const userResponse = await fetch('/api/users/current');
                        const userResult = await userResponse.json();
                        
                        if (!userResult.success || !userResult.facility) {
                            this.error = 'No facility assigned to your account';
                            this.dispensing = false;
                            return;
                        }

                        const request = {
                            prescriptionId: this.selectedPrescription.prescriptionId,
                            facilityId: userResult.facility.facilityId,
                            dispensedById: userResult.user.userId
                        };

                        const response = await fetch('/api/dispensing/dispense', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(request)
                        });

                        const result = await response.json();

                        if (result.success) {
                            this.dispenseResult = result.data;
                            this.showModal = false;
                            this.showSuccess = true;
                            this.loadPendingPrescriptions();
                            showToast('Prescription dispensed successfully!', 'success');
                        } else {
                            this.error = result.message || 'Dispensing failed';
                            showToast(this.error, 'error');
                        }
                    } catch (err) {
                        console.error('Error dispensing:', err);
                        this.error = 'An error occurred while dispensing';
                        showToast(this.error, 'error');
                    } finally {
                        this.dispensing = false;
                    }
                },

                resetAndRefresh() {
                    this.showSuccess = false;
                    this.dispenseResult = null;
                    this.loadPendingPrescriptions();
                },

                closeModal() {
                    this.showModal = false;
                    this.selectedPrescription = null;
                    this.referenceCode = '';
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                },

                formatDateTime(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                }
            }
        }
    </script>
}