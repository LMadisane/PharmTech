@{
    ViewData["Title"] = "Receipts";
    var isAdmin = User.IsInRole("Admin");
}

<div x-data="receiptsApp()" x-init="init()" class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">🧾 Receipts & Transactions</h1>
        <p class="text-gray-500 text-sm">View, filter, and download transaction receipts</p>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Filter Receipts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Patient Name</label>
                <input type="text"
                       x-model="filters.patientName"
                       placeholder="Search by patient..."
                       class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Medicine Name</label>
                <input type="text"
                       x-model="filters.medicineName"
                       placeholder="Search by medicine..."
                       class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Receipt Type</label>
                <select x-model="filters.receiptType"
                        class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                    <option value="">All Types</option>
                    <option value="Dispense">💊 Dispense</option>
                    <option value="Return">↩️ Return</option>
                    <option value="Order">🛒 Order</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Date Range</label>
                <div class="flex gap-2">
                    <input type="date"
                           x-model="filters.from"
                           class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                    <span class="self-center text-gray-400">—</span>
                    <input type="date"
                           x-model="filters.to"
                           class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                </div>
            </div>
        </div>
        <div class="flex flex-wrap gap-3 mt-4">
            <button @@click="applyFilters()"
                class="bg-teal-600 hover:bg-teal-700 text-white font-medium px-5 py-2 rounded-lg transition duration-200 text-sm">
                🔍 Apply Filters
            </button>
            <button @@click="resetFilters()"
                class="border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium px-5 py-2 rounded-lg transition duration-200 text-sm">
                🔄 Reset
            </button>
            @if (isAdmin)
            {
                <button @@click="downloadHistory()"
                    :disabled="downloading"
                    class="bg-purple-600 hover:bg-purple-700 text-white font-medium px-5 py-2 rounded-lg transition duration-200 text-sm ml-auto">
                    <span x-show="!downloading">📥 Download History</span>
                    <span x-show="downloading" class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Generating...
                    </span>
                </button>
            }
        </div>
    </div>

    <!-- Receipts Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Receipt No</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Patient</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Medicine</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <template x-for="receipt in receipts" :key="receipt.receiptId">
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <span class="font-mono text-sm font-medium text-gray-800" x-text="receipt.receiptNumber"></span>
                            </td>
                            <td class="px-6 py-4">
                                <span :class="receiptTypeBadge(receipt.receiptType)"
                                      class="inline-flex px-2 py-1 text-xs font-semibold rounded-full">
                                    <span x-text="getReceiptTypeIcon(receipt.receiptType)"></span>
                                    <span class="ml-1" x-text="receipt.receiptType"></span>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700" x-text="receipt.patientName"></td>
                            <td class="px-6 py-4 text-sm text-gray-700" x-text="receipt.medicineName"></td>
                            <td class="px-6 py-4 text-sm font-medium text-gray-800" x-text="receipt.quantity"></td>
                            <td class="px-6 py-4 text-sm text-gray-500" x-text="formatDate(receipt.generatedAt)"></td>
                            <td class="px-6 py-4">
                                <button @@click="viewReceipt(receipt.receiptId)"
                                    class="text-teal-600 hover:text-teal-800 text-sm font-medium mr-3 transition">
                                    View
                                </button>
                                <button @@click="downloadReceipt(receipt.receiptId)"
                                    class="text-blue-600 hover:text-blue-800 text-sm font-medium transition">
                                    PDF
                                </button>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="loading && receipts.length === 0">
                        <td colspan="7" class="px-6 py-12 text-center">
                            <div class="flex justify-center">
                                <svg class="animate-spin h-8 w-8 text-teal-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                            <p class="mt-2 text-gray-400 text-sm">Loading receipts...</p>
                        </td>
                    </tr>
                    <tr x-show="!loading && receipts.length === 0">
                        <td colspan="7" class="px-6 py-12 text-center">
                            <div class="text-gray-400">
                                <span class="text-4xl">📭</span>
                                <p class="mt-2">No receipts found</p>
                                <p class="text-xs mt-1">Start dispensing prescriptions to generate receipts</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Receipt Detail Modal -->
    <div x-show="showModal"
         x-cloak
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @@click.away="closeModal()">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto" @@click.stop>
            <div class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex justify-between items-center">
                <h3 class="text-lg font-bold text-gray-800">Receipt Details</h3>
                <button @@click="closeModal()" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="p-6" x-show="selectedReceipt">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-50 rounded-2xl mb-3">
                        <span class="text-3xl">💊</span>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800">PharmTech</h2>
                    <p class="text-xs text-gray-400">Smart Medicine. Seamless Care.</p>
                    <div class="mt-3 h-px bg-gray-200"></div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div>
                        <p class="text-xs text-gray-400">Receipt Number</p>
                        <p class="text-sm font-mono font-semibold text-gray-800" x-text="selectedReceipt?.receiptNumber"></p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400">Receipt Type</p>
                        <p class="text-sm font-medium" x-text="selectedReceipt?.receiptType"></p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400">Generated By</p>
                        <p class="text-sm text-gray-700" x-text="selectedReceipt?.generatedBy?.name || 'N/A'"></p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400">Generated At</p>
                        <p class="text-sm text-gray-700" x-text="formatDateTime(selectedReceipt?.generatedAt)"></p>
                    </div>
                </div>

                <div class="h-px bg-gray-200 my-4"></div>

                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Transaction Details</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-gray-400">Patient Name</p>
                            <p class="text-sm font-medium text-gray-800" x-text="selectedReceipt?.patientName"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Medicine</p>
                            <p class="text-sm font-medium text-gray-800" x-text="selectedReceipt?.medicineName"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Quantity</p>
                            <p class="text-sm font-medium text-gray-800" x-text="selectedReceipt?.quantity"></p>
                        </div>
                        <div x-show="selectedReceipt?.notes">
                            <p class="text-xs text-gray-400">Notes</p>
                            <p class="text-sm text-gray-600" x-text="selectedReceipt?.notes"></p>
                        </div>
                    </div>
                </div>

                <div class="h-px bg-gray-200 my-4"></div>

                <div class="text-center">
                    <p class="text-xs text-gray-400">Thank you. This is an official PharmTech receipt.</p>
                    <p class="text-xs text-gray-300 mt-2">© 2026 PharmTech — Louis Madisane</p>
                </div>

                <div class="flex gap-3 mt-6 pt-4 border-t border-gray-100">
                    <button @@click="downloadReceipt(selectedReceipt?.receiptId)"
                        class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-medium px-4 py-2 rounded-lg transition text-sm">
                        📄 Download PDF
                    </button>
                    <button @@click="closeModal()"
                        class="flex-1 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium px-4 py-2 rounded-lg transition text-sm">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function receiptsApp() {
            return {
                receipts: [],
                loading: false,
                showModal: false,
                selectedReceipt: null,
                downloading: false,
                filters: {
                    patientName: '',
                    medicineName: '',
                    receiptType: '',
                    from: '',
                    to: ''
                },

                init() {
                    this.loadReceipts();
                },

                async loadReceipts() {
                    this.loading = true;
                    try {
                        const queryParams = new URLSearchParams();
                        if (this.filters.patientName) queryParams.append('patientName', this.filters.patientName);
                        if (this.filters.medicineName) queryParams.append('medicineName', this.filters.medicineName);
                        if (this.filters.receiptType) queryParams.append('receiptType', this.filters.receiptType);
                        if (this.filters.from) queryParams.append('from', this.filters.from);
                        if (this.filters.to) queryParams.append('to', this.filters.to);

                        const response = await fetch(`/api/receipt?${queryParams.toString()}`);
                        const result = await response.json();
                        
                        if (result && result.success !== undefined) {
                            this.receipts = result.receipts || [];
                        } else {
                            this.receipts = [];
                        }
                    } catch (err) {
                        console.error('Error loading receipts:', err);
                        this.receipts = [];
                    } finally {
                        this.loading = false;
                    }
                },

                applyFilters() {
                    this.loadReceipts();
                },

                resetFilters() {
                    this.filters = {
                        patientName: '',
                        medicineName: '',
                        receiptType: '',
                        from: '',
                        to: ''
                    };
                    this.loadReceipts();
                },

                async viewReceipt(id) {
                    try {
                        const response = await fetch(`/api/receipt/${id}`);
                        const result = await response.json();

                        if (result.success && result.receipt) {
                            this.selectedReceipt = result.receipt;
                            this.showModal = true;
                        }
                    } catch (err) {
                        console.error('Error fetching receipt:', err);
                    }
                },

                downloadReceipt(id) {
                    window.open(`/api/receipt/${id}/download`, '_blank');
                },

                async downloadHistory() {
                    this.downloading = true;
                    try {
                        const queryParams = new URLSearchParams();
                        if (this.filters.patientName) queryParams.append('patientName', this.filters.patientName);
                        if (this.filters.medicineName) queryParams.append('medicineName', this.filters.medicineName);
                        if (this.filters.receiptType) queryParams.append('receiptType', this.filters.receiptType);
                        if (this.filters.from) queryParams.append('from', this.filters.from);
                        if (this.filters.to) queryParams.append('to', this.filters.to);

                        const url = `/api/receipt/download/history?${queryParams.toString()}`;
                        window.open(url, '_blank');
                    } catch (err) {
                        console.error('Error downloading history:', err);
                    } finally {
                        this.downloading = false;
                    }
                },

                closeModal() {
                    this.showModal = false;
                    this.selectedReceipt = null;
                },

                receiptTypeBadge(type) {
                    const badges = {
                        'Dispense': 'bg-green-100 text-green-800',
                        'Return': 'bg-yellow-100 text-yellow-800',
                        'Order': 'bg-blue-100 text-blue-800'
                    };
                    return badges[type] || 'bg-gray-100 text-gray-800';
                },

                getReceiptTypeIcon(type) {
                    const icons = {
                        'Dispense': '💊',
                        'Return': '↩️',
                        'Order': '🛒'
                    };
                    return icons[type] || '📄';
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                },

                formatDateTime(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                }
            }
        }
    </script>
}