@{
    ViewData["Title"] = "Edit User";
}

<div x-data="editUserApp()" x-init="init()" class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center gap-3">
            <a asp-controller="UserManagement" asp-action="Index" class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300 transition">
                ← Back to Users
            </a>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Edit User</h1>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">Update user information</p>
    </div>

    <!-- Loading State -->
    <div x-show="loading" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
        <div class="flex justify-center">
            <svg class="animate-spin h-8 w-8 text-teal-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
        <p class="mt-2 text-gray-400 text-sm">Loading user data...</p>
    </div>

    <!-- Form Card -->
    <div x-show="!loading" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
        <form @@submit.prevent="updateUser()">
            <!-- Full Name -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Full Name *</label>
                <input type="text"
                       x-model="form.name"
                       required
                       class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent dark:bg-gray-700 dark:text-white">
            </div>

            <!-- Email -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Email Address *</label>
                <input type="email"
                       x-model="form.email"
                       required
                       class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent dark:bg-gray-700 dark:text-white">
            </div>

            <!-- Role (Disabled - cannot change role after creation) -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Role</label>
                <input type="text"
                       x-model="form.role"
                       disabled
                       class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 cursor-not-allowed">
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Role cannot be changed after creation</p>
            </div>

            <!-- Facility (only for Doctors and Pharmacists) -->
            <div class="mb-5" x-show="form.role !== 'Patient'">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Facility</label>
                <select x-model="form.facilityId"
                        class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent dark:bg-gray-700 dark:text-white">
                    <option value="">No facility assigned</option>
                    <template x-for="facility in facilities" :key="facility.facilityId">
                        <option :value="facility.facilityId" x-text="facility.name"></option>
                    </template>
                </select>
            </div>

            <!-- Active Status -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Status</label>
                <div class="flex items-center gap-4">
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="radio" x-model="form.isActive" :value="true" class="w-4 h-4 text-teal-600 focus:ring-teal-500">
                        <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Active</span>
                    </label>
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="radio" x-model="form.isActive" :value="false" class="w-4 h-4 text-red-600 focus:ring-red-500">
                        <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Inactive</span>
                    </label>
                </div>
            </div>

            <!-- Error Message -->
            <div x-show="error" x-text="error" class="mb-4 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 rounded-xl px-4 py-2"></div>

            <!-- Submit Buttons -->
            <div class="flex gap-3">
                <button type="submit"
                        x-bind:disabled="updating || !form.name || !form.email"
                        class="flex-1 bg-teal-600 hover:bg-teal-700 disabled:bg-teal-400 text-white font-semibold px-6 py-3 rounded-xl transition duration-200">
                    <span x-show="!updating">Save Changes</span>
                    <span x-show="updating" class="flex items-center justify-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Saving...
                    </span>
                </button>
                <a asp-controller="UserManagement" asp-action="Index"
                       class="flex-1 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold px-6 py-3 rounded-xl transition duration-200 text-center">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function editUserApp() {
            return {
                userId: null,
                facilities: [],
                loading: true,
                updating: false,
                error: null,
                form: {
                    name: '',
                    email: '',
                    role: '',
                    facilityId: '',
                    isActive: true
                },

                init() {
                    // Get user ID from URL
                    const path = window.location.pathname;
                    const parts = path.split('/');
                    this.userId = parts[parts.length - 1];
                    this.loadUser();
                    this.loadFacilities();
                },

                async loadFacilities() {
                    try {
                        const response = await fetch('/api/usermanagement/facilities');
                        const result = await response.json();
                        if (result.success) {
                            this.facilities = result.facilities || [];
                        }
                    } catch (err) {
                        console.error('Error loading facilities:', err);
                    }
                },

                async loadUser() {
                    this.loading = true;
                    try {
                        const response = await fetch(`/api/usermanagement/users/${this.userId}`);
                        const result = await response.json();
                        
                        if (result && result.success) {
                            this.form.name = result.user.name;
                            this.form.email = result.user.email;
                            this.form.role = result.user.role;
                            this.form.facilityId = result.user.facilityId || '';
                            this.form.isActive = result.user.isActive;
                        } else {
                            this.error = result.message || 'Failed to load user';
                            showToast(this.error, 'error');
                        }
                    } catch (err) {
                        console.error('Error loading user:', err);
                        this.error = 'An error occurred while loading the user';
                        showToast(this.error, 'error');
                    } finally {
                        this.loading = false;
                    }
                },

                async updateUser() {
                    this.updating = true;
                    this.error = null;

                    try {
                        const response = await fetch(`/api/usermanagement/users/${this.userId}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                name: this.form.name,
                                email: this.form.email,
                                facilityId: this.form.facilityId ? parseInt(this.form.facilityId) : null,
                                isActive: this.form.isActive
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            showToast('User updated successfully!', 'success');
                            window.location.href = '/UserManagement/Index';
                        } else {
                            this.error = result.message || 'Failed to update user';
                            showToast(this.error, 'error');
                        }
                    } catch (err) {
                        console.error('Error updating user:', err);
                        this.error = 'An error occurred while updating the user';
                        showToast(this.error, 'error');
                    } finally {
                        this.updating = false;
                    }
                }
            }
        }
    </script>
}