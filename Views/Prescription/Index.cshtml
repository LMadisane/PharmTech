@{
    ViewData["Title"] = "Prescriptions";
    var isDoctor = User.IsInRole("Doctor");
    var isPharmacist = User.IsInRole("Pharmacist");
    var isAdmin = User.IsInRole("Admin");
}

<div x-data="prescriptionsApp()" x-init="init()" class="max-w-7xl mx-auto">
    <!-- Header with New Prescription Button -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">📋 Prescriptions</h1>
            <p class="text-gray-500 text-sm">View and manage all prescriptions</p>
        </div>
        @if (isDoctor)
        {
            <a asp-controller="Prescription" asp-action="CreatePrescription"
                   class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-5 py-2.5 rounded-xl transition duration-200 text-sm flex items-center gap-2">
                <span>➕</span> New Prescription
            </a>
        }
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Filter Prescriptions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select x-model="filters.status"
                        class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                    <option value="">All Statuses</option>
                    <option value="Pending">⏳ Pending</option>
                    <option value="Dispensed">✅ Dispensed</option>
                    <option value="Cancelled">❌ Cancelled</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Patient Name</label>
                <input type="text"
                       x-model="filters.patientName"
                       placeholder="Search by patient..."
                       class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Medicine</label>
                <input type="text"
                       x-model="filters.medicineName"
                       placeholder="Search by medicine..."
                       class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Date Range</label>
                <div class="flex gap-2">
                    <input type="date"
                           x-model="filters.from"
                           class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                    <span class="self-center text-gray-400">—</span>
                    <input type="date"
                           x-model="filters.to"
                           class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
                </div>
            </div>
        </div>
        <div class="flex flex-wrap gap-3 mt-4">
            <button @@click="applyFilters()"
                class="bg-teal-600 hover:bg-teal-700 text-white font-medium px-5 py-2 rounded-lg transition duration-200 text-sm">
                🔍 Apply Filters
            </button>
            <button @@click="resetFilters()"
                class="border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium px-5 py-2 rounded-lg transition duration-200 text-sm">
                🔄 Reset
            </button>
        </div>
    </div>

    <!-- Prescriptions Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Reference</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Patient</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Medicine</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Dosage</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <template x-for="prescription in prescriptions" :key="prescription.prescriptionId">
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <span class="font-mono text-sm font-medium text-gray-800" x-text="prescription.referenceCode"></span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700" x-text="prescription.patient.name"></td>
                            <td class="px-6 py-4 text-sm text-gray-700" x-text="prescription.medicine.name"></td>
                            <td class="px-6 py-4 text-sm text-gray-700" x-text="prescription.dosagePerDay + '/day'"></td>
                            <td class="px-6 py-4 text-sm font-medium text-gray-800" x-text="prescription.totalQuantity"></td>
                            <td class="px-6 py-4">
                                <span :class="statusBadge(prescription.status)" class="px-2 py-1 text-xs font-semibold rounded-full">
                                    <span x-text="prescription.status"></span>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500" x-text="formatDate(prescription.prescribedAt)"></td>
                            <td class="px-6 py-4">
                                <button @@click="viewDetails(prescription.prescriptionId)"
                                    class="text-teal-600 hover:text-teal-800 text-sm font-medium mr-3 transition">
                                    View
                                </button>
                                @if (isDoctor)
                                {
                                    <button x-show="prescription.status === 'Pending'"
                                        @@click="cancelPrescription(prescription.prescriptionId)"
                                            class="text-red-600 hover:text-red-800 text-sm font-medium transition">
                                        Cancel
                                    </button>
                                }
                            </td>
                        </tr>
                    </template>
                    <tr x-show="loading && prescriptions.length === 0">
                        <td colspan="8" class="px-6 py-12 text-center">
                            <div class="flex justify-center">
                                <svg class="animate-spin h-8 w-8 text-teal-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                            <p class="mt-2 text-gray-400 text-sm">Loading prescriptions...</p>
                        </td>
                    </tr>
                    <tr x-show="!loading && prescriptions.length === 0">
                        <td colspan="8" class="px-6 py-12 text-center">
                            <div class="text-gray-400">
                                <span class="text-4xl">📭</span>
                                <p class="mt-2">No prescriptions found</p>
                                @if (isDoctor)
                                {
                                    <p class="text-xs mt-1">Click "New Prescription" to create one</p>
                                }
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Prescription Detail Modal -->
    <div x-show="showModal"
         x-cloak
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @@click.away="closeModal()">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto" @@click.stop>
            <div class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex justify-between items-center">
                <h3 class="text-lg font-bold text-gray-800">Prescription Details</h3>
                <button @@click="closeModal()" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="p-6" x-show="selectedPrescription">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-50 rounded-2xl mb-3">
                        <span class="text-3xl">📋</span>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800">Prescription</h2>
                    <p class="text-xs text-gray-400 font-mono" x-text="selectedPrescription?.referenceCode"></p>
                    <div class="mt-3 h-px bg-gray-200"></div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div>
                        <p class="text-xs text-gray-400">Status</p>
                        <span :class="statusBadge(selectedPrescription?.status)" class="inline-block px-2 py-1 text-xs font-semibold rounded-full mt-1">
                            <span x-text="selectedPrescription?.status"></span>
                        </span>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400">Prescribed Date</p>
                        <p class="text-sm text-gray-700" x-text="formatDateTime(selectedPrescription?.prescribedAt)"></p>
                    </div>
                </div>

                <div class="h-px bg-gray-200 my-4"></div>

                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Patient Information</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-gray-400">Patient Name</p>
                            <p class="text-sm font-medium text-gray-800" x-text="selectedPrescription?.patient?.name"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Patient Email</p>
                            <p class="text-sm text-gray-700" x-text="selectedPrescription?.patient?.email"></p>
                        </div>
                    </div>
                </div>

                <div class="h-px bg-gray-200 my-4"></div>

                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Prescription Details</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-gray-400">Medicine</p>
                            <p class="text-sm font-medium text-gray-800" x-text="selectedPrescription?.medicine?.name"></p>
                            <p class="text-xs text-gray-400" x-text="selectedPrescription?.medicine?.dosageForm"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Dosage</p>
                            <p class="text-sm text-gray-800" x-text="selectedPrescription?.dosagePerDay + ' time(s) per day'"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Duration</p>
                            <p class="text-sm text-gray-800" x-text="selectedPrescription?.durationDays + ' days'"></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Total Quantity</p>
                            <p class="text-sm font-semibold text-gray-800" x-text="selectedPrescription?.totalQuantity + ' units'"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function prescriptionsApp() {
            return {
                prescriptions: [],
                loading: false,
                showModal: false,
                selectedPrescription: null,
                filters: {
                    status: '',
                    patientName: '',
                    medicineName: '',
                    from: '',
                    to: ''
                },

                init() {
                    this.loadPrescriptions();
                },

                async loadPrescriptions() {
                    this.loading = true;
                    try {
                        const queryParams = new URLSearchParams();
                        if (this.filters.status) queryParams.append('status', this.filters.status);
                        if (this.filters.patientName) queryParams.append('patientName', this.filters.patientName);
                        if (this.filters.medicineName) queryParams.append('medicineName', this.filters.medicineName);
                        if (this.filters.from) queryParams.append('from', this.filters.from);
                        if (this.filters.to) queryParams.append('to', this.filters.to);

                        const response = await fetch(`/api/prescription?${queryParams.toString()}`);
                        const result = await response.json();
                        
                        if (result && result.success) {
                            this.prescriptions = result.prescriptions || [];
                        } else {
                            this.prescriptions = [];
                        }
                    } catch (err) {
                        console.error('Error loading prescriptions:', err);
                        this.prescriptions = [];
                    } finally {
                        this.loading = false;
                    }
                },

                applyFilters() {
                    this.loadPrescriptions();
                },

                resetFilters() {
                    this.filters = {
                        status: '',
                        patientName: '',
                        medicineName: '',
                        from: '',
                        to: ''
                    };
                    this.loadPrescriptions();
                },

                async viewDetails(id) {
                    try {
                        const response = await fetch(`/api/prescription/${id}`);
                        const result = await response.json();

                        if (result.success && result.prescription) {
                            this.selectedPrescription = result.prescription;
                            this.showModal = true;
                        }
                    } catch (err) {
                        console.error('Error fetching prescription:', err);
                    }
                },

                async cancelPrescription(id) {
                    if (!confirm('Are you sure you want to cancel this prescription?')) return;
                    
                    try {
                        const response = await fetch(`/api/prescription/${id}/cancel`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const result = await response.json();

                        if (result.success) {
                            showToast('Prescription cancelled successfully', 'success');
                            this.loadPrescriptions();
                        } else {
                            showToast(result.message || 'Failed to cancel prescription', 'error');
                        }
                    } catch (err) {
                        console.error('Error cancelling prescription:', err);
                        showToast('An error occurred', 'error');
                    }
                },

                closeModal() {
                    this.showModal = false;
                    this.selectedPrescription = null;
                },

                statusBadge(status) {
                    const badges = {
                        'Pending': 'bg-yellow-100 text-yellow-800',
                        'Dispensed': 'bg-green-100 text-green-800',
                        'Cancelled': 'bg-red-100 text-red-800'
                    };
                    return badges[status] || 'bg-gray-100 text-gray-800';
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                },

                formatDateTime(dateString) {
                    if (!dateString) return 'N/A';
                    const date = new Date(dateString);
                    return date.toLocaleString('en-ZA', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                }
            }
        }
    </script>
}