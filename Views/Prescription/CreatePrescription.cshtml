@{
    ViewData["Title"] = "Create Prescription";
}

<div x-data="createPrescriptionApp()" x-init="init()" class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center gap-3">
            <a href="/prescriptions" class="text-teal-600 hover:text-teal-700 transition">
                ← Back
            </a>
            <h1 class="text-2xl font-bold text-gray-800">➕ New Prescription</h1>
        </div>
        <p class="text-gray-500 text-sm mt-1">Create a new prescription for a patient</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <form @@submit.prevent="submitPrescription()">
            <!-- Patient Selection -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Patient *</label>
                <select x-model="form.patientId"
                        required
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent">
                    <option value="">Select a patient...</option>
                    <template x-for="patient in patients" :key="patient.userId">
                        <option :value="patient.userId" x-text="patient.name + ' (' + patient.email + ')'"></option>
                    </template>
                </select>
                <div x-show="patients.length === 0 && !loadingPatients" class="mt-2 text-sm text-yellow-600">
                    No patients found. Please add patients first.
                </div>
            </div>

            <!-- Medicine Selection -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Medicine *</label>
                <select x-model="form.medId"
                        required
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent">
                    <option value="">Select a medicine...</option>
                    <template x-for="medicine in medicines" :key="medicine.medId">
                        <option :value="medicine.medId" x-text="medicine.name + ' (' + medicine.dosageForm + ')'"></option>
                    </template>
                </select>
                <div x-show="medicines.length === 0 && !loadingMedicines" class="mt-2 text-sm text-yellow-600">
                    No medicines found. Please add medicines first.
                </div>
            </div>

            <!-- Dosage -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Dosage (times per day) *</label>
                <input type="number"
                       x-model="form.dosagePerDay"
                       min="1"
                       max="10"
                       required
                       placeholder="e.g., 2"
                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent">
                <p class="text-xs text-gray-400 mt-1">Number of times the patient should take the medication daily</p>
            </div>

            <!-- Duration -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Duration (days) *</label>
                <input type="number"
                       x-model="form.durationDays"
                       min="1"
                       max="90"
                       required
                       placeholder="e.g., 7"
                       class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent">
                <p class="text-xs text-gray-400 mt-1">Number of days the prescription should last</p>
            </div>

            <!-- Summary Card -->
            <div x-show="form.dosagePerDay && form.durationDays" class="bg-teal-50 rounded-xl p-4 mb-6">
                <h4 class="text-sm font-semibold text-teal-800 mb-2">Summary</h4>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-teal-700">Total Quantity Required:</span>
                    <span class="text-xl font-bold text-teal-800" x-text="form.dosagePerDay * form.durationDays"></span>
                </div>
                <p class="text-xs text-teal-600 mt-1">units</p>
            </div>

            <!-- Error Message -->
            <div x-show="error" x-text="error" class="mb-4 text-sm text-red-600 bg-red-50 rounded-xl px-4 py-2"></div>

            <!-- Submit Buttons -->
            <div class="flex gap-3">
                <button type="submit"
                        :disabled="submitting || !form.patientId || !form.medId || !form.dosagePerDay || !form.durationDays"
                        class="flex-1 bg-teal-600 hover:bg-teal-700 disabled:bg-teal-400 text-white font-semibold px-6 py-3 rounded-xl transition duration-200">
                    <span x-show="!submitting">✅ Create Prescription</span>
                    <span x-show="submitting" class="flex items-center justify-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Creating...
                    </span>
                </button>
                <a href="/prescriptions" class="flex-1 border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-6 py-3 rounded-xl transition duration-200 text-center">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <!-- Success Modal -->
    <div x-show="showSuccess"
         x-cloak
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
        @@click.away="showSuccess = false">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full mx-4 p-6" @@click.stop>
            <div class="text-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">✅</span>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Prescription Created!</h3>
                <p class="text-gray-500 text-sm mb-4">The prescription has been created successfully.</p>
                <div class="bg-gray-50 rounded-xl p-4 mb-4 text-left">
                    <p class="text-sm text-gray-600"><strong>Reference Code:</strong></p>
                    <p class="font-mono text-sm text-teal-600" x-text="createdReferenceCode"></p>
                </div>
                <div class="flex gap-3">
                    <button @@click="resetForm()" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-xl transition">
                        Create Another
                    </button>
                    <a href="/prescriptions" class="flex-1 border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-4 py-2 rounded-xl transition text-center">
                        View All
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] { display: none !important; }
    </style>
    <script>
        function createPrescriptionApp() {
            return {
                patients: [],
                medicines: [],
                loadingPatients: false,
                loadingMedicines: false,
                submitting: false,
                showSuccess: false,
                createdReferenceCode: '',
                error: null,
                form: {
                    patientId: '',
                    medId: '',
                    dosagePerDay: '',
                    durationDays: ''
                },

                init() {
                    this.loadPatients();
                    this.loadMedicines();
                },

                async loadPatients() {
                    this.loadingPatients = true;
                    try {
                        const response = await fetch('/api/prescription/patients');
                        const result = await response.json();
                        if (result.success) {
                            this.patients = result.patients || [];
                        }
                    } catch (err) {
                        console.error('Error loading patients:', err);
                    } finally {
                        this.loadingPatients = false;
                    }
                },

                async loadMedicines() {
                    this.loadingMedicines = true;
                    try {
                        const response = await fetch('/api/prescription/medicines');
                        const result = await response.json();
                        if (result.success) {
                            this.medicines = result.medicines || [];
                        }
                    } catch (err) {
                        console.error('Error loading medicines:', err);
                    } finally {
                        this.loadingMedicines = false;
                    }
                },

                async submitPrescription() {
                    this.submitting = true;
                    this.error = null;

                    try {
                        const response = await fetch('/api/prescription', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                patientId: parseInt(this.form.patientId),
                                medId: parseInt(this.form.medId),
                                dosagePerDay: parseInt(this.form.dosagePerDay),
                                durationDays: parseInt(this.form.durationDays)
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            this.createdReferenceCode = result.prescription.referenceCode;
                            this.showSuccess = true;
                            showToast('Prescription created successfully!', 'success');
                        } else {
                            this.error = result.message || 'Failed to create prescription';
                            showToast(this.error, 'error');
                        }
                    } catch (err) {
                        console.error('Error creating prescription:', err);
                        this.error = 'An error occurred while creating the prescription';
                        showToast(this.error, 'error');
                    } finally {
                        this.submitting = false;
                    }
                },

                resetForm() {
                    this.showSuccess = false;
                    this.form = {
                        patientId: '',
                        medId: '',
                        dosagePerDay: '',
                        durationDays: ''
                    };
                    this.error = null;
                }
            }
        }
    </script>
}