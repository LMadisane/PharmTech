@{
    ViewData["Title"] = "Suppliers";
    var isAdmin = User.IsInRole("Admin");
}

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">🚚 Suppliers</h1>
            <p class="text-gray-700 dark:text-gray-400 text-sm">Manage medicine suppliers</p>
        </div>
        @if (isAdmin)
        {
            <a href="/Supplier/CreateSupplier"
                   class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-5 py-2.5 rounded-xl transition duration-200 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add New Supplier
            </a>
        }
    </div>

    <!-- Search bar -->
    <div class="glass p-4 mb-6 transition-all duration-300">
        <div class="flex gap-3 flex-wrap sm:flex-nowrap">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">
                    Search Suppliers
                </label>
                <div class="glass-search w-full">
                    <svg class="search-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text"
                           x-model="searchTerm"
                    @@input="filterSuppliers()"
                           placeholder="Search by supplier name or contact..."
                           class="w-full px-4 py-2 bg-transparent border-0 focus:ring-0 text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 text-sm">
                </div>
            </div>
            <div class="flex items-end">
                <button @@click="clearSearch()"
                    x-show="searchTerm"
                    class="glass-filter">
                    ✕ Clear
                </button>
            </div>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-3"
           x-show="filteredSuppliers.length !== suppliers.length">
            Showing <span x-text="filteredSuppliers.length"></span> of <span x-text="suppliers.length"></span> suppliers
        </p>
    </div>

    <!-- Suppliers Table -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-700 border-b border-gray-100 dark:border-gray-600">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Contact Info</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Address</th>
                        @if (isAdmin)
                        {
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var supplier in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                            <td class="px-6 py-4 text-sm font-medium text-gray-800 dark:text-gray-200">@supplier.Name</td>
                            <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">@supplier.ContactInfo</td>
                            <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">@supplier.Address</td>
                            @if (isAdmin)
                            {
                                <td class="px-6 py-4">
                                    <a href="/Supplier/EditSupplier/@supplier.SupplierId"
                                           class="text-teal-600 hover:text-teal-800 dark:text-teal-400 dark:hover:text-teal-300 text-sm font-medium transition">
                                        Edit
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Toast for success message -->
    @if (TempData["Success"] != null)
    {
        <script>
                showToast('@TempData["Success"]', 'success');
        </script>
    }
</div>