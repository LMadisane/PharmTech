@{
    ViewData["Title"] = "Facilities";
}

<div x-data="facilityApp()" x-init="init()" class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">🏥 Medical Facilities</h1>
            <p class="text-gray-700 dark:text-gray-400 text-sm">Manage healthcare facilities</p>
        </div>
        <a href="/Facility/CreateFacility"
           class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-5 py-2.5 rounded-xl transition duration-200 text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add New Facility
        </a>
    </div>

    <!-- Search Bar -->
    <div class="glass p-4 mb-6 transition-all duration-300">
        <div class="flex gap-3 flex-wrap sm:flex-nowrap">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">
                    Search Facilities
                </label>
                <div class="glass-search w-full">
                    <svg class="search-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text"
                           x-model="searchTerm"
                    @@input="filterFacilities()"
                           placeholder="Search by facility name..."
                           class="w-full px-4 py-2 bg-transparent border-0 focus:ring-0 text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 text-sm">
                </div>
            </div>
            <div class="flex items-end">
                <button @@click="clearSearch()"
                    x-show="searchTerm"
                    class="glass-filter">
                    ✕ Clear
                </button>
            </div>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-3"
           x-show="filteredFacilities.length !== facilities.length">
            Showing <span x-text="filteredFacilities.length"></span> of <span x-text="facilities.length"></span> facilities
        </p>
    </div>
    
    <!-- Facilities Table -->
    <div class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm rounded-2xl border border-white/30 dark:border-gray-700/30 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50/50 dark:bg-gray-700/50 border-b border-gray-100 dark:border-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Address</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Contact Info</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    <template x-for="facility in filteredFacilities" :key="facility.facilityId">
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-700/50 transition">
                            <td class="px-6 py-4 text-sm font-medium text-gray-800 dark:text-gray-200" x-text="facility.name"></td>
                            <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400" x-text="facility.address || 'N/A'"></td>
                            <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400" x-text="facility.contactInfo || 'N/A'"></td>
                            <td class="px-6 py-4">
                                <a :href="'/Facility/EditFacility/' + facility.facilityId"
                                   class="text-teal-600 hover:text-teal-800 dark:text-teal-400 dark:hover:text-teal-300 text-sm font-medium mr-3 transition">
                                    Edit
                                </a>
                                <button @@click="deleteFacility(facility.facilityId, facility.name)"
                                    class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 text-sm font-medium transition">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="loading && facilities.length === 0">
                        <td colspan="4" class="px-6 py-12 text-center">
                            <div class="flex justify-center">
                                <svg class="animate-spin h-8 w-8 text-teal-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                            <p class="mt-2 text-gray-400 text-sm">Loading facilities...</p>
                        </td>
                    </tr>
                    <tr x-show="!loading && filteredFacilities.length === 0">
                        <td colspan="4" class="px-6 py-12 text-center">
                            <div class="text-gray-400">
                                <span class="text-4xl">📭</span>
                                <p class="mt-2" x-show="facilities.length === 0">No facilities found</p>
                                <p class="mt-2" x-show="facilities.length > 0">No facilities match your search</p>
                                <p class="text-xs mt-1" x-show="facilities.length === 0">Click "Add New Facility" to create one</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function facilityApp() {
            return {
                facilities: [],
                filteredFacilities: [],
                searchTerm: '',
                loading: false,

                init() {
                    this.loadFacilities();
                },

                async loadFacilities() {
                    this.loading = true;
                    try {
                        const response = await fetch('/api/facility');
                        const result = await response.json();

                        if (result && result.success) {
                            this.facilities = result.facilities || [];
                            this.filteredFacilities = this.facilities;
                        } else {
                            this.facilities = [];
                            this.filteredFacilities = [];
                        }
                    } catch (err) {
                        console.error('Error loading facilities:', err);
                        this.facilities = [];
                        this.filteredFacilities = [];
                    } finally {
                        this.loading = false;
                    }
                },

                filterFacilities() {
                    if (!this.searchTerm) {
                        this.filteredFacilities = this.facilities;
                        return;
                    }
                    const term = this.searchTerm.toLowerCase();
                    this.filteredFacilities = this.facilities.filter(facility =>
                        facility.name.toLowerCase().includes(term)
                    );
                },

                clearSearch() {
                    this.searchTerm = '';
                    this.filteredFacilities = this.facilities;
                },

                async deleteFacility(id, name) {
                    if (!confirm(`Are you sure you want to delete "${name}"? This action cannot be undone.`)) return;

                    try {
                        const response = await fetch(`/api/facility/${id}`, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const result = await response.json();

                        if (result.success) {
                            showToast(result.message, 'success');
                            this.loadFacilities();
                        } else {
                            showToast(result.message || 'Failed to delete facility', 'error');
                        }
                    } catch (err) {
                        console.error('Error deleting facility:', err);
                        showToast('An error occurred', 'error');
                    }
                }
            }
        }
    </script>
}