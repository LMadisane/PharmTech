@{
    ViewData["Title"] = "Create Facility";
}

<div x-data="createFacilityApp()" x-init="init()" class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center gap-3">
            <a asp-controller="Facility" asp-action="Index" class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300 transition">
                ←Back
            </a>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Add New Facility</h1>
        </div>
        <p class="text-gray-700 dark:text-gray-400 text-sm mt-1">Add a healthcare facility to the system</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
        <form @@submit.prevent="submitFacility()">
            <!-- Facility Name -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Facility Name *</label>
                <input type="text"
                       x-model="form.name"
                       required
                       placeholder="e.g., UTH (University Teaching Hospital)"
                       class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent dark:bg-gray-700 dark:text-white">
            </div>

            <!-- Address -->
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Address</label>
                <textarea x-model="form.address"
                          rows="2"
                          placeholder="e.g., Nationalist Rd, Lusaka"
                          class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent dark:bg-gray-700 dark:text-white"></textarea>
            </div>

            <!-- Contact Info -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Contact Information</label>
                <input type="text"
                       x-model="form.contactInfo"
                       placeholder="e.g., +260 211 123 456"
                       class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent dark:bg-gray-700 dark:text-white">
            </div>

            <!-- Error Message -->
            <div x-show="error" x-text="error" class="mb-4 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 rounded-xl px-4 py-2"></div>

            <!-- Submit Buttons -->
            <div class="flex gap-3">
                <button type="submit"
                        x-bind:disabled="submitting || !form.name"
                        class="flex-1 bg-teal-600 hover:bg-teal-700 disabled:bg-teal-600 text-white font-semibold px-6 py-3 rounded-xl transition duration-200">
                    <span x-show="!submitting">Create Facility</span>
                    <span x-show="submitting" class="flex items-center justify-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Creating...
                    </span>
                </button>
                <a asp-controller="Facility" asp-action="Index" class="flex-1 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold px-6 py-3 rounded-xl transition duration-200 text-center">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <!-- Success Modal -->
    <div x-show="showSuccess"
         x-cloak
         x-transition.opacity.duration.300ms
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
        @@click.away="showSuccess = false">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl max-w-md w-full mx-4 p-6" @@click.stop>
            <div class="text-center">
                <div class="w-16 h-16 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">✅</span>
                </div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Facility Created!</h3>
                <p class="text-gray-500 dark:text-gray-400 text-sm mb-4">The facility has been created successfully.</p>
                <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 mb-4 text-left">
                    <p class="text-sm text-gray-600 dark:text-gray-300"><strong>Name:</strong> <span x-text="createdFacilityName"></span></p>
                </div>
                <div class="flex gap-3">
                    <button @@click="resetForm()" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2 rounded-xl transition">
                        Create Another
                    </button>
                    <a asp-controller="Facility" asp-action="Index" class="flex-1 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold px-4 py-2 rounded-xl transition text-center">
                        View All Facilities
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
    <script>
        function createFacilityApp() {
            return {
                submitting: false,
                showSuccess: false,
                createdFacilityName: '',
                error: null,
                form: {
                    name: '',
                    address: '',
                    contactInfo: ''
                },

                init() {
                    // Initialization if needed
                },

                async submitFacility() {
                    this.submitting = true;
                    this.error = null;

                    try {
                        const response = await fetch('/api/facility', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                name: this.form.name,
                                address: this.form.address,
                                contactInfo: this.form.contactInfo
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            this.createdFacilityName = result.facility.name;
                            this.showSuccess = true;
                            showToast('Facility created successfully!', 'success');
                        } else {
                            this.error = result.message || 'Failed to create facility';
                            showToast(this.error, 'error');
                        }
                    } catch (err) {
                        console.error('Error creating facility:', err);
                        this.error = 'An error occurred while creating the facility';
                        showToast(this.error, 'error');
                    } finally {
                        this.submitting = false;
                    }
                },

                resetForm() {
                    this.showSuccess = false;
                    this.form = {
                        name: '',
                        address: '',
                        contactInfo: ''
                    };
                    this.error = null;
                }
            }
        }
    </script>
}