@{
    ViewData["Title"] = "📊 Dashboard";
}

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">

    <!-- Total Medicines -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-5 border border-gray-100 dark:border-gray-700 flex flex-col gap-2 transition-colors duration-300">
        <div class="flex items-center justify-between">
            <span class="text-2xl">💊</span>
            <span class="text-xs font-medium text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-900/30 px-2 py-1 rounded-full">Medicines</span>
        </div>
        <p class="text-3xl font-bold text-gray-800 dark:text-white">@ViewBag.TotalMedicines</p>
        <p class="text-sm text-gray-400 dark:text-gray-500">Total Medicines</p>
    </div>

    <!-- Total Prescriptions -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-5 border border-gray-100 dark:border-gray-700 flex flex-col gap-2 transition-colors duration-300">
        <div class="flex items-center justify-between">
            <span class="text-2xl">📋</span>
            <span class="text-xs font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-1 rounded-full">Prescriptions</span>
        </div>
        <p class="text-3xl font-bold text-gray-800 dark:text-white">@ViewBag.TotalPrescriptions</p>
        <p class="text-sm text-gray-400 dark:text-gray-500">Total Prescriptions</p>
    </div>

    <!-- Pending Orders -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-5 border border-gray-100 dark:border-gray-700 flex flex-col gap-2 transition-colors duration-300">
        <div class="flex items-center justify-between">
            <span class="text-2xl">🛒</span>
            <span class="text-xs font-medium text-yellow-600 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/30 px-2 py-1 rounded-full">Orders</span>
        </div>
        <p class="text-3xl font-bold text-gray-800 dark:text-white">@ViewBag.PendingOrders</p>
        <p class="text-sm text-gray-400 dark:text-gray-500">Pending Orders</p>
    </div>

    <!-- Pending Returns -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-5 border border-gray-100 dark:border-gray-700 flex flex-col gap-2 transition-colors duration-300">
        <div class="flex items-center justify-between">
            <span class="text-2xl">↩️</span>
            <span class="text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-2 py-1 rounded-full">Returns</span>
        </div>
        <p class="text-3xl font-bold text-gray-800 dark:text-white">@ViewBag.PendingReturns</p>
        <p class="text-sm text-gray-400 dark:text-gray-500">Pending Returns</p>
    </div>

    <!-- Total Users -->
    @if (User.IsInRole("Admin"))
    {
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-5 border border-gray-100 dark:border-gray-700 flex flex-col gap-2 transition-colors duration-300">
            <div class="flex items-center justify-between">
                <span class="text-2xl">👥</span>
                <span class="text-xs font-medium text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/30 px-2 py-1 rounded-full">Users</span>
            </div>
            <p class="text-3xl font-bold text-gray-800 dark:text-white">@ViewBag.TotalUsers</p>
            <p class="text-sm text-gray-400 dark:text-gray-500">Total Users</p>
        </div>

        <!-- Total Facilities -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-5 border border-gray-100 dark:border-gray-700 flex flex-col gap-2 transition-colors duration-300">
            <div class="flex items-center justify-between">
                <span class="text-2xl">🏥</span>
                <span class="text-xs font-medium text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-700 px-2 py-1 rounded-full">Facilities</span>
            </div>
            <p class="text-3xl font-bold text-gray-800 dark:text-white">@ViewBag.TotalFacilities</p>
            <p class="text-sm text-gray-400 dark:text-gray-500">Total Facilities</p>
        </div>
    }

</div>

<!-- Alerts Banner -->
@if (ViewBag.UnreadAlerts > 0)
{
    <div class="bg-yellow-50 dark:bg-yellow-900/30 border border-yellow-200 dark:border-yellow-800 text-yellow-800 dark:text-yellow-200 rounded-2xl px-5 py-4 mb-6 flex items-center gap-3 transition-colors duration-300">
        <span class="text-2xl">⚠️</span>
        <div>
            <p class="font-semibold">You have @ViewBag.UnreadAlerts unread system alert(s)</p>
            <p class="text-sm text-yellow-600 dark:text-yellow-400">Check inventory levels and expiry dates.</p>
        </div>
    </div>
}

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

    <!-- Stock Levels Chart -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-6 border border-gray-100 dark:border-gray-700 transition-colors duration-300">
        <h2 class="text-base font-semibold text-gray-700 dark:text-gray-300 mb-4">📦 Stock Levels</h2>
        @if (((List<string>)ViewBag.StockLabels).Any())
        {
            <canvas id="stockChart" height="200"></canvas>
        }
        else
        {
            <div class="flex items-center justify-center h-48 text-gray-400 dark:text-gray-500 text-sm">
                No inventory data available yet.
            </div>
        }
    </div>

    <!-- Prescription Status Chart -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-6 border border-gray-100 dark:border-gray-700 transition-colors duration-300">
        <h2 class="text-base font-semibold text-gray-700 dark:text-gray-300 mb-4">📋 Prescription Status</h2>
        @if (ViewBag.TotalPrescriptions > 0)
        {
            <canvas id="prescriptionChart" height="200"></canvas>
        }
        else
        {
            <div class="flex items-center justify-center h-48 text-gray-400 dark:text-gray-500 text-sm">
                No prescription data available yet.
            </div>
        }
    </div>

</div>

<!-- Returns Chart -->
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-6 border border-gray-100 dark:border-gray-700 mb-6 transition-colors duration-300">
    <h2 class="text-base font-semibold text-gray-700 dark:text-gray-300 mb-4">↩️ Drug Returns</h2>
    @if (((List<string>)ViewBag.ReturnsLabels).Any())
    {
        <canvas id="returnsChart" height="100"></canvas>
    }
    else
    {
        <div class="flex items-center justify-center h-24 text-gray-400 dark:text-gray-500 text-sm">
            No returns data available yet.
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Stock Levels Bar Chart
        @if (((List<string>)ViewBag.StockLabels).Any())
        {
            <text>
                renderStockChart('stockChart',
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StockLabels)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StockQuantities))
                );
            </text>
        }

        // Prescription Status Doughnut Chart
        @if (ViewBag.TotalPrescriptions > 0)
        {
            <text>
                renderPrescriptionChart('prescriptionChart',
                @ViewBag.DispensedPrescriptions,
                @ViewBag.PendingPrescriptions
                );
            </text>
        }

        // Drug Returns Bar Chart
        @if (((List<string>)ViewBag.ReturnsLabels).Any())
        {
            <text>
                renderReturnsChart('returnsChart',
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ReturnsLabels)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ReturnsQuantities))
                );
            </text>
        }
    </script>
}